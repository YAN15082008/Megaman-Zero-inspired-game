#Can only get hit by the pogo, knockbacks when it's a normal attack but no damage.
#I am trying to make him hurt and knockback the player when hit by the shield.

extends CharacterBody2D

const GRAVITY := 1200.0
const MAX_FALL_SPEED := 800.0
var is_being_knocked := false
var _knockback_tween: Tween

@export var move_speed := 60.0
@export var aggro_range := 300.0
@export var contact_damage := 10  # damage dealt by touching this enemy
@export var max_hp := 30

@onready var attack_hitbox: Area2D = $hitbox
var _player: Node2D


func _ready() -> void:
	# Register the contact-damage area in the "inimigos" group at runtime
	var area := get_node_or_null("Area2D")
	if area != null:
		area.add_to_group("inimigos")
		area.set_meta("contact_damage", contact_damage)
	# Sync max_hp to the hurtbox (also resets current hp)
	var hurt: Node = get_node_or_null("Hurtbox")
	if hurt != null:
		hurt.max_hp = max_hp
		hurt.hp = max_hp


func _find_player() -> Node2D:
	if not is_instance_valid(_player):
		_player = get_tree().get_first_node_in_group("player")
	return _player


func _physics_process(delta: float) -> void:
	if is_being_knocked:
		return

	if not is_on_floor():
		velocity.y += GRAVITY * delta
		velocity.y = minf(velocity.y, MAX_FALL_SPEED)

	var player := _find_player()
	if is_instance_valid(player):
		var dist: float = global_position.distance_to(player.global_position)
		if dist <= aggro_range:
			var dir := -1.0 if player.global_position.x < global_position.x else 1.0
			velocity.x = dir * move_speed
		else:
			velocity.x = move_toward(velocity.x, 0.0, 500.0 * delta)
	else:
		velocity.x = move_toward(velocity.x, 0.0, 500.0 * delta)

	move_and_slide()


func apply_knockback(direction: Vector2, strength: float) -> void:
	is_being_knocked = true
	velocity = Vector2.ZERO
	if _knockback_tween and _knockback_tween.is_valid():
		_knockback_tween.kill()
	var start_y: float = position.y
	var target_x: float = position.x + direction.x * strength   # <<< KNOCKBACK DISTANCE: strength (15) × direction (±1) = pixels moved sideways
	var peak_y: float = position.y - strength * 0.4            # <<< KNOCKBACK ARC HEIGHT: strength × 0.4 = pixels upward
	_knockback_tween = create_tween().set_parallel(true)
	_knockback_tween.tween_property(self, "position:x", target_x, 0.1)  # <<< KNOCKBACK SPEED: 0.1 = seconds to slide sideways (lower = faster)
	_knockback_tween.tween_property(self, "position:y", peak_y, 0.06).set_ease(Tween.EASE_OUT)  # <<< ARC UP: 0.06s to rise
	_knockback_tween.chain().tween_property(self, "position:y", start_y, 0.1).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)  # <<< FALL DOWN: 0.1s to drop back
	_knockback_tween.chain().tween_callback(_end_knockback)  # <<< RECOVERY TIME: total ~0.16s before enemy can act again


func _end_knockback() -> void:
	is_being_knocked = false
	velocity = Vector2.ZERO


# Helper function to get the attack direction
func get_attack_direction() -> Vector2:
	var player := get_tree().get_first_node_in_group("player")
	if player and player.is_on_floor() and player.is_in_group("player"):
		return player.get_global_transform().x * Vector2(1, 0)  # direction based on x-axis
	else:
		return Vector2.RIGHT  # default if not on floor or not found


# Called when the player's attack hitbox hits the shielder
func _on_hurtbox_area_entered(area: Area2D) -> void:
	if not area.has_method("take_damage"):
		return
	
	var attack_type = attack_hitbox.get_meta("attack_type", "unknown")
	var damage = attack_hitbox.get_meta("damage", 10)
	
	# Only take damage from "down" and "slash" attacks
	if attack_type == "down" or attack_type == "slash":
		area.take_damage(damage)
		apply_knockback(get_attack_direction(), damage * 0.5)  # adjust multiplier as needed
