extends Area2D
# Explosion left behind by the bomb.
# Stays still, deals damage on contact with the player's hurtbox,
# then disappears after 5 seconds.

@export var damage    := 20
@export var lifetime  := 5.0

var _already_hit := false   # damage the player once per explosion lifetime


func _ready() -> void:
	add_to_group("explosao")
	await get_tree().create_timer(lifetime).timeout
	if is_instance_valid(self):
		# Fade out quickly then free
		var t := create_tween()
		t.tween_property($AnimatedSprite2D, "modulate:a", 0.0, 0.4)
		t.tween_callback(queue_free)


func _on_area_entered(area: Area2D) -> void:
	if _already_hit:
		return
	if not area.is_in_group("hurtbox"):
		return
	_already_hit = true

	var player := get_tree().get_first_node_in_group("player") as Node
	if not is_instance_valid(player):
		return
	if player.has_method("take_damage"):
		player.take_damage(damage)
