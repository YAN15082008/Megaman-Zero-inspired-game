#Just walks back and forth and follows the player when it is close enough. When it reaches, it damages the player once and starts to drag him around, with the only way out being dashing. 
#It's best to pogo because the enemy hurtbox and hitbox is above it's head.

extends CharacterBody2D

const GRAVITY := 1200.0
const MAX_FALL_SPEED := 800.0
var is_being_knocked := false
var _knockback_tween: Tween

@export var move_speed := 80.0
@export var patrol_distance := 100.0
@export var aggro_range := 300.0
@export var contact_damage := 8
@export var max_hp := 15

var _origin_x: float
var _dir := 1.0
var _player: Node2D


func _ready() -> void:
	_origin_x = position.x
	# Register the contact-damage area in the "inimigos" group at runtime
	var area := get_node_or_null("Area2D")
	if area != null:
		area.add_to_group("inimigos")
		area.set_meta("contact_damage", contact_damage)
	# Sync max_hp to the hurtbox
	var hurt: Node = get_node_or_null("Hurtbox")
	if hurt != null:
		hurt.max_hp = max_hp
		hurt.hp = max_hp


func _find_player() -> Node2D:
	if not is_instance_valid(_player):
		_player = get_tree().get_first_node_in_group("player")
	return _player


func _physics_process(delta: float) -> void:
	if is_being_knocked:
		return

	if not is_on_floor():
		velocity.y += GRAVITY * delta
		velocity.y = minf(velocity.y, MAX_FALL_SPEED)

	var player := _find_player()
	if is_instance_valid(player):
		var dist: float = global_position.distance_to(player.global_position)
		if dist <= aggro_range:
			# Chase player
			var dir := -1.0 if player.global_position.x < global_position.x else 1.0
			velocity.x = dir * move_speed
		else:
			# Patrol back and forth around origin
			var dx: float = position.x - _origin_x
			if dx > patrol_distance:
				_dir = -1.0
			elif dx < -patrol_distance:
				_dir = 1.0
			velocity.x = _dir * move_speed
	else:
		velocity.x = move_toward(velocity.x, 0.0, 500.0 * delta)

	move_and_slide()


func apply_knockback(direction: Vector2, strength: float) -> void:
	is_being_knocked = true
	velocity = Vector2.ZERO
	if _knockback_tween and _knockback_tween.is_valid():
		_knockback_tween.kill()
	var start_y: float = position.y
	var target_x: float = position.x + direction.x * strength   # <<< KNOCKBACK DISTANCE: strength × direction = pixels sideways
	var peak_y: float = position.y - strength * 0.4            # <<< KNOCKBACK ARC HEIGHT: strength × 0.4 = pixels upward
	_knockback_tween = create_tween().set_parallel(true)
	_knockback_tween.tween_property(self, "position:x", target_x, 0.1)  # <<< KNOCKBACK SPEED: 0.1s sideways slide
	_knockback_tween.tween_property(self, "position:y", peak_y, 0.06).set_ease(Tween.EASE_OUT)  # <<< ARC UP: 0.06s rise
	_knockback_tween.chain().tween_property(self, "position:y", start_y, 0.1).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN)  # <<< FALL DOWN: 0.1s drop
	_knockback_tween.chain().tween_callback(_end_knockback)  # <<< RECOVERY: ~0.16s total


func _end_knockback() -> void:
	is_being_knocked = false
	velocity = Vector2.ZERO
